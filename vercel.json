{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth.js" },
    { "source": "/api/admin/:path*", "destination": "/api/auth.js" },
    { "source": "/pages/:path*", "destination": "/pages/:path*.html" },
    { "source": "/auth/login", "destination": "/pages/admin.html" },
    { "source": "/auth/google/login", "destination": "/pages/login.html" },
    { "source": "/jadwal-rilis", "destination": "/pages/jadwal-rilis.html" },
    { "source": "/anime-list", "destination": "/pages/anime-list.html" },
    { "source": "/anime-terbaru", "destination": "/pages/anime-terbaru.html" },
    { "source": "/batch", "destination": "/pages/batch.html" },
    { "source": "/anime", "destination": "/pages/anime.html" },
    { "source": "/watch", "destination": "/pages/watch.html" },
    { "source": "/admin", "destination": "/pages/admin.html" },
    { "source": "/login", "destination": "/pages/login.html" },
    { "source": "/user", "destination": "/pages/user.html" },
    { "source": "/:page.html", "destination": "/pages/:page.html" }
  ]
}
